{
  "global_settings": {
    "ingress_url": "http://192.168.92.131:30476/productpage"
  },
  "test_cases": [
    {
      "case_id": "case_001",
      "description": "正向匹配路由测试 for host '*'",
      "type": "single_request",
      "request_params": {
        "host": "*",
        "path": ""
      },
      "expected_outcome": {
        "destination": "productpage",
        "note": "验证正向命中路由。"
      },
      "source_service": "*"
    },
    {
      "case_id": "case_002",
      "description": "正向匹配路由测试 for host 'productpage'",
      "type": "single_request",
      "request_params": {
        "host": "productpage",
        "headers": {
          "end-user": "zcx"
        }
      },
      "expected_outcome": {
        "destination": "v1",
        "note": "验证正向命中路由。"
      },
      "source_service": "productpage"
    },
    {
      "case_id": "case_003",
      "description": "正交组合测试(traffic_split) for host 'reviews'",
      "type": "load_test",
      "request_params": {
        "host": "reviews",
        "path": "/"
      },
      "load_params": {
        "num_requests": 62,
        "concurrency": 1
      },
      "expected_outcome": {
        "distribution": {
          "v1": "approx 0.20",
          "v2": "approx 0.80"
        },
        "margin_of_error": "0.05",
        "behaviors": [
          "验证流量分割：v1(20%), v2(80%)"
        ]
      },
      "source_service": "reviews",
      "test_strategies": [
        "traffic_split"
      ]
    },
    {
      "case_id": "case_004",
      "description": "全局/局部正交组合测试(circuit_breaker+connection_pool+routing) for host 'productpage'",
      "type": "load_test",
      "request_params": {
        "host": "productpage",
        "trigger_condition": "simulate_high_load_with_errors",
        "connection_pool_test": true
      },
      "load_params": {
        "concurrency": 20,
        "num_requests": 75,
        "ramp_up_time": "10s"
      },
      "expected_outcome": {
        "behaviors": [
          "连接池限制：最大TCP连接1，HTTP挂起请求1",
          "熔断触发：5次连续错误后熔断",
          "路由匹配：验证请求正确路由到目标版本"
        ],
        "circuit_breaker_threshold": 5,
        "connection_limits": {
          "tcp": 1,
          "http_pending": 1
        },
        "orthogonal_note": "全局策略(DR)与局部策略(VS)的正交验证"
      },
      "source_service": "productpage",
      "test_strategies": [
        "circuit_breaker",
        "connection_pool",
        "routing"
      ]
    }
  ]
}