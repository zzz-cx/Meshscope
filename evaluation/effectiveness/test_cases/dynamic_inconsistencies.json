{
  "test_suite": "dynamic_inconsistencies",
  "description": "动态行为不一致性检测测试用例",
  "version": "1.0",
  "test_cases": [
    {
      "case_id": "DYNAMIC_001",
      "name": "流量分发异常检测",
      "description": "实际流量分发与VirtualService配置不匹配",
      "category": "traffic_distribution_mismatch",
      "severity": "high",
      "config_files": [
        "configs/traffic_split_config.yaml"
      ],
      "test_scenario": {
        "load_params": {
          "requests": 1000,
          "concurrency": 10,
          "duration": "5m"
        },
        "expected_distribution": {
          "reviews-v1": 80,
          "reviews-v2": 20
        },
        "tolerance": 5
      },
      "expected_detection": {
        "should_detect": true,
        "error_type": "traffic_distribution_anomaly",
        "error_message": "Actual traffic distribution deviates from configured weights",
        "threshold": "deviation > 10%"
      },
      "injection_config": {
        "simulate_anomaly": true,
        "actual_distribution": {
          "reviews-v1": 60,
          "reviews-v2": 40
        }
      }
    },
    {
      "case_id": "DYNAMIC_002",
      "name": "故障注入不生效检测",
      "description": "配置的故障注入策略在运行时未生效",
      "category": "fault_injection_failure",
      "severity": "high",
      "config_files": [
        "configs/fault_injection_config.yaml"
      ],
      "test_scenario": {
        "fault_config": {
          "delay": {
            "percentage": 50,
            "fixed_delay": "5s"
          },
          "abort": {
            "percentage": 10,
            "http_status": 503
          }
        },
        "load_params": {
          "requests": 500,
          "concurrency": 5
        }
      },
      "expected_detection": {
        "should_detect": true,
        "error_type": "fault_injection_not_active",
        "error_message": "Configured fault injection is not affecting traffic",
        "indicators": ["no_delays_observed", "no_503_responses"]
      },
      "injection_config": {
        "disable_fault_injection": true,
        "expected_delay_responses": 250,
        "expected_abort_responses": 50
      }
    },
    {
      "case_id": "DYNAMIC_003",
      "name": "重试策略失效检测",
      "description": "配置的重试策略在故障时未正常工作",
      "category": "retry_policy_failure",
      "severity": "medium",
      "config_files": [
        "configs/retry_policy_config.yaml"
      ],
      "test_scenario": {
        "retry_config": {
          "attempts": 3,
          "per_try_timeout": "2s",
          "retry_on": "5xx"
        },
        "fault_injection": {
          "abort": {
            "percentage": 50,
            "http_status": 500
          }
        },
        "load_params": {
          "requests": 200,
          "concurrency": 2
        }
      },
      "expected_detection": {
        "should_detect": true,
        "error_type": "retry_policy_ineffective",
        "error_message": "Retry policy not reducing failure rate as expected",
        "indicators": ["high_failure_rate", "no_retry_attempts_logged"]
      },
      "injection_config": {
        "disable_retry": true,
        "expected_retry_attempts": 100,
        "expected_success_rate_improvement": 0.3
      }
    },
    {
      "case_id": "DYNAMIC_004",
      "name": "熔断器状态异常检测",
      "description": "熔断器未在预期条件下触发",
      "category": "circuit_breaker_anomaly",
      "severity": "medium",
      "config_files": [
        "configs/circuit_breaker_config.yaml"
      ],
      "test_scenario": {
        "circuit_breaker_config": {
          "consecutive_errors": 5,
          "interval": "30s",
          "base_ejection_time": "30s"
        },
        "load_params": {
          "requests": 100,
          "concurrency": 20,
          "error_rate": 0.8
        }
      },
      "expected_detection": {
        "should_detect": true,
        "error_type": "circuit_breaker_not_triggered",
        "error_message": "Circuit breaker should have triggered but didn't",
        "indicators": ["continuous_errors", "no_ejection_events"]
      },
      "injection_config": {
        "disable_circuit_breaker": true,
        "expected_ejection_events": 2,
        "consecutive_error_threshold": 5
      }
    },
    {
      "case_id": "DYNAMIC_005",
      "name": "超时策略异常检测",
      "description": "配置的超时时间与实际观察不符",
      "category": "timeout_policy_mismatch",
      "severity": "low",
      "config_files": [
        "configs/timeout_config.yaml"
      ],
      "test_scenario": {
        "timeout_config": {
          "timeout": "3s"
        },
        "backend_delay": "5s",
        "load_params": {
          "requests": 50,
          "concurrency": 1
        }
      },
      "expected_detection": {
        "should_detect": true,
        "error_type": "timeout_not_enforced",
        "error_message": "Requests taking longer than configured timeout",
        "indicators": ["response_times_exceed_timeout"]
      },
      "injection_config": {
        "disable_timeout": true,
        "expected_timeout_responses": 50,
        "actual_response_time": "5s"
      }
    },
    {
      "case_id": "DYNAMIC_006",
      "name": "正常动态行为测试（阴性对照）",
      "description": "正常情况下配置与实际行为应当一致",
      "category": "negative_control",
      "severity": "info",
      "config_files": [
        "configs/normal_behavior_config.yaml"
      ],
      "test_scenario": {
        "load_params": {
          "requests": 200,
          "concurrency": 5,
          "duration": "2m"
        },
        "expected_behavior": "normal"
      },
      "expected_detection": {
        "should_detect": false,
        "error_type": null,
        "error_message": null,
        "indicators": ["all_behaviors_match_config"]
      },
      "injection_config": {
        "no_anomaly_injection": true
      }
    }
  ],
  "evaluation_metrics": {
    "behavioral_detection_rate": "detected_behavioral_issues / actual_behavioral_issues",
    "runtime_accuracy": "correct_runtime_assessments / total_runtime_tests",
    "anomaly_sensitivity": "detected_anomalies / injected_anomalies",
    "false_alert_rate": "false_behavioral_alerts / total_behavioral_alerts"
  },
  "execution_requirements": {
    "monitoring_tools": ["prometheus", "jaeger", "envoy_access_logs"],
    "load_generation": "fortio",
    "observation_period": "5m",
    "cooldown_period": "2m"
  }
}
