{
  "test_suite": "static_inconsistencies",
  "description": "静态配置不一致性检测测试用例",
  "version": "1.0",
  "test_cases": [
    {
      "case_id": "STATIC_001",
      "name": "路由规则冲突检测",
      "description": "同一服务的多个VirtualService存在冲突的路由规则",
      "category": "route_conflict",
      "severity": "high",
      "config_files": [
        "configs/conflicting_virtualservices.yaml"
      ],
      "expected_detection": {
        "should_detect": true,
        "error_type": "route_conflict",
        "error_message": "Multiple VirtualServices define conflicting routes for same host",
        "affected_services": ["reviews"]
      },
      "test_data": {
        "vs1_priority": 10,
        "vs2_priority": 10,
        "conflicting_paths": ["/reviews", "/reviews/.*"]
      }
    },
    {
      "case_id": "STATIC_002", 
      "name": "DestinationRule重复定义检测",
      "description": "同一服务存在多个DestinationRule定义相同subset",
      "category": "destination_rule_conflict",
      "severity": "high",
      "config_files": [
        "configs/duplicate_destination_rules.yaml"
      ],
      "expected_detection": {
        "should_detect": true,
        "error_type": "duplicate_subset",
        "error_message": "Multiple DestinationRules define same subset for host",
        "affected_services": ["productpage"]
      },
      "test_data": {
        "host": "productpage.default.svc.cluster.local",
        "duplicate_subsets": ["v1", "v2"]
      }
    },
    {
      "case_id": "STATIC_003",
      "name": "服务引用不存在检测", 
      "description": "VirtualService引用不存在的服务",
      "category": "service_reference_error",
      "severity": "medium",
      "config_files": [
        "configs/missing_service_reference.yaml"
      ],
      "expected_detection": {
        "should_detect": true,
        "error_type": "service_not_found",
        "error_message": "VirtualService references non-existent service",
        "affected_services": ["non-existent-service"]
      },
      "test_data": {
        "referenced_service": "non-existent-service.default.svc.cluster.local",
        "vs_name": "missing-service-vs"
      }
    },
    {
      "case_id": "STATIC_004",
      "name": "Gateway选择器错误检测",
      "description": "Gateway的selector指向不存在的标签",
      "category": "gateway_selector_error", 
      "severity": "medium",
      "config_files": [
        "configs/invalid_gateway_selector.yaml"
      ],
      "expected_detection": {
        "should_detect": true,
        "error_type": "selector_mismatch",
        "error_message": "Gateway selector doesn't match any existing pods",
        "affected_resources": ["invalid-gateway"]
      },
      "test_data": {
        "selector": {
          "istio": "non-existent-gateway"
        },
        "gateway_name": "invalid-gateway"
      }
    },
    {
      "case_id": "STATIC_005",
      "name": "权重分配错误检测",
      "description": "VirtualService中流量权重总和不等于100",
      "category": "weight_allocation_error",
      "severity": "low",
      "config_files": [
        "configs/invalid_weight_allocation.yaml"
      ],
      "expected_detection": {
        "should_detect": true,
        "error_type": "invalid_weight_sum",
        "error_message": "Traffic weight sum is not 100%",
        "affected_services": ["details"]
      },
      "test_data": {
        "weights": {
          "v1": 60,
          "v2": 50
        },
        "total_weight": 110,
        "expected_total": 100
      }
    },
    {
      "case_id": "STATIC_006",
      "name": "正常配置测试（阴性对照）",
      "description": "正确的配置不应该触发任何检测",
      "category": "negative_control",
      "severity": "info",
      "config_files": [
        "configs/valid_configuration.yaml"
      ],
      "expected_detection": {
        "should_detect": false,
        "error_type": null,
        "error_message": null,
        "affected_services": []
      },
      "test_data": {
        "services": ["reviews", "productpage", "details"],
        "all_weights_sum": 100,
        "all_references_valid": true
      }
    }
  ],
  "evaluation_metrics": {
    "detection_rate": "detected_issues / total_actual_issues",
    "false_positive_rate": "false_alarms / total_detections", 
    "false_negative_rate": "missed_issues / total_actual_issues",
    "accuracy": "(correct_detections + correct_passes) / total_cases"
  },
  "execution_order": [
    "STATIC_001",
    "STATIC_002", 
    "STATIC_003",
    "STATIC_004",
    "STATIC_005",
    "STATIC_006"
  ]
}
