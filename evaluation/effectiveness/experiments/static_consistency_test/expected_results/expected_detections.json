{
  "expected_results": {
    "description": "各测试用例的预期检测结果",
    "version": "1.0",
    "test_cases": {
      "vs_dr_mismatch.yaml": {
        "expected_issues": 1,
        "issues": [
          {
            "type": "subset_reference_error",
            "severity": "high",
            "description": "VirtualService引用的subset 'v4'在DestinationRule中不存在",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "reviews-mismatch",
              "namespace": "default",
              "field_path": "spec.http[0].route[2].destination.subset"
            },
            "suggestion": "在DestinationRule中添加v4 subset定义，或修改VirtualService路由配置"
          }
        ]
      },
      
      "weight_error.yaml": {
        "expected_issues": 1,
        "issues": [
          {
            "type": "weight_allocation_error",
            "severity": "medium",
            "description": "路由权重总和为110%，不等于100%",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "reviews-weight-error",
              "namespace": "default",
              "field_path": "spec.http[0].route"
            },
            "details": {
              "actual_weight_sum": 110,
              "expected_weight_sum": 100,
              "weight_distribution": {
                "v1": 33,
                "v2": 33,
                "v3": 44
              }
            },
            "suggestion": "调整权重分配使总和等于100%"
          }
        ]
      },
      
      "duplicate_envoyfilter.yaml": {
        "expected_issues": 1,
        "issues": [
          {
            "type": "policy_conflict",
            "severity": "high",
            "description": "多个EnvoyFilter配置了相同工作负载的相同过滤器",
            "location": {
              "resource_type": "EnvoyFilter",
              "resource_names": ["adservice-rate-limit-1", "adservice-rate-limit-2"],
              "namespace": "online-boutique"
            },
            "details": {
              "conflicting_filters": [
                "envoy.filters.http.local_ratelimit"
              ],
              "affected_workload": {
                "app": "adservice"
              }
            },
            "suggestion": "合并重复的EnvoyFilter配置或使用不同的过滤器名称"
          }
        ]
      },
      
      "missing_service_ref.yaml": {
        "expected_issues": 3,
        "issues": [
          {
            "type": "service_reference_error",
            "severity": "high",
            "description": "VirtualService引用的服务不存在",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "missing-service-ref",
              "namespace": "default",
              "field_path": "spec.hosts[0]"
            },
            "details": {
              "referenced_service": "nonexistent-service.default.svc.cluster.local"
            },
            "suggestion": "检查服务名称拼写或确保服务已部署"
          },
          {
            "type": "service_reference_error",
            "severity": "high",
            "description": "DestinationRule引用的服务不存在",
            "location": {
              "resource_type": "DestinationRule",
              "resource_name": "missing-service-dr",
              "namespace": "default",
              "field_path": "spec.host"
            },
            "details": {
              "referenced_service": "another-missing-service.default.svc.cluster.local"
            },
            "suggestion": "检查服务名称拼写或确保服务已部署"
          },
          {
            "type": "service_reference_error",
            "severity": "high",
            "description": "VirtualService路由目标服务不存在",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "valid-to-invalid-ref",
              "namespace": "default",
              "field_path": "spec.http[1].route[0].destination.host"
            },
            "details": {
              "referenced_service": "invalid-backend.default.svc.cluster.local"
            },
            "suggestion": "检查后端服务名称或确保服务已部署"
          }
        ]
      },
      
      "gateway_selector_error.yaml": {
        "expected_issues": 2,
        "issues": [
          {
            "type": "selector_mismatch",
            "severity": "medium",
            "description": "Gateway选择器没有匹配到任何Pod",
            "location": {
              "resource_type": "Gateway",
              "resource_name": "invalid-gateway",
              "namespace": "default",
              "field_path": "spec.selector"
            },
            "details": {
              "selector": {
                "istio": "nonexistent-gateway"
              }
            },
            "suggestion": "检查Gateway选择器标签是否正确"
          },
          {
            "type": "gateway_reference_error",
            "severity": "medium",
            "description": "VirtualService引用了不存在的Gateway",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "vs-with-invalid-gateway",
              "namespace": "default",
              "field_path": "spec.gateways[1]"
            },
            "details": {
              "referenced_gateway": "nonexistent-gateway"
            },
            "suggestion": "检查Gateway名称拼写或确保Gateway已定义"
          }
        ]
      },
      
      "bookinfo_with_errors.yaml": {
        "expected_issues": 3,
        "issues": [
          {
            "type": "weight_allocation_error",
            "severity": "medium",
            "description": "路由权重总和为110%，不等于100%",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "reviews-mixed",
              "namespace": "default"
            }
          },
          {
            "type": "subset_reference_error",
            "severity": "high",
            "description": "VirtualService引用的subset 'v3'在DestinationRule中不存在",
            "location": {
              "resource_type": "VirtualService",
              "resource_name": "reviews-mixed",
              "namespace": "default"
            }
          },
          {
            "type": "service_reference_error",
            "severity": "high",
            "description": "DestinationRule引用的服务不存在",
            "location": {
              "resource_type": "DestinationRule",
              "resource_name": "ratings-mixed",
              "namespace": "default"
            },
            "details": {
              "referenced_service": "ratings-nonexistent.default.svc.cluster.local"
            }
          }
        ]
      }
    },
    
    "summary": {
      "total_test_cases": 6,
      "total_expected_issues": 11,
      "issue_type_distribution": {
        "subset_reference_error": 2,
        "weight_allocation_error": 2,
        "policy_conflict": 1,
        "service_reference_error": 4,
        "selector_mismatch": 1,
        "gateway_reference_error": 1
      },
      "severity_distribution": {
        "high": 7,
        "medium": 4,
        "low": 0
      }
    }
  }
}
