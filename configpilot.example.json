{
  "namespace": "default",
  "log_level": "INFO",
  "cluster": {
    "ssh_host": null,
    "ssh_port": 22,
    "ssh_user": "root",
    "ssh_password": null,
    "k8s_host": null,
    "k8s_port": 6443,
    "k8s_token": null
  },
  "observability": {
    "prometheus_url": null,
    "jaeger_url": null,
    "zipkin_url": null,
    "kiali_url": null,
    "grafana_url": null,
    "ingress_url": null,
    "ingress_port": 30476
  },
  "static": {
    "control_plane_config_dir": "istio_config_parser/istio_monitor/istio_control_config",
    "data_plane_config_dir": "istio_config_parser/istio_monitor/istio_sidecar_config",
    "ingress_plane_config_dir": "istio_config_parser/istio_monitor/istio_ingress_config"
  },
  "dynamic": {
    "validation_engine": "relational",
    "validation_output_dir": "results/relational",
    "backend_control_url": null,
    "activation_headers_file": null,
    "behavior_profiles_file": null,
    "compute_backend": "serial",
    "compute_workers": 2,
    "traffic_workers": 1,
    "capacity_budget": 64,
    "go_binary": null,
    "istio_config_file": "istio_Dynamic_Test/configs/istio_config.json",
    "service_dependencies_file": "istio_Dynamic_Test/service_dependencies.json",
    "test_matrix_file": "istio_Dynamic_Test/configs/output_matrix.json",
    "envoy_logs_dir": "istio_Dynamic_Test/results/envoy_logs",
    "http_results_dir": "istio_Dynamic_Test/results/http_results",
    "verification_dir": "istio_Dynamic_Test/results/verification",
    "enabled_policies": {
      "routing": true,
      "retry": true,
      "circuit_breaker": true,
      "rate_limit": true,
      "fault_injection": true,
      "orthogonal_minimize": false
    }
  },
  "monitor": {
    "interval": 1200,
    "config_types": "routes,clusters,listeners",
    "data_plane_method": "istioctl",
    "ingress_method": "kubectl-exec"
